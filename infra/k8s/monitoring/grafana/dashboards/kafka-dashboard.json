{
  "dashboard": {
    "title": "AEGIS Kafka Monitoring",
    "uid": "aegis-kafka",
    "tags": ["aegis", "kafka", "streaming"],
    "timezone": "utc",
    "refresh": "10s",
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "panels": [
      {
        "id": 1,
        "title": "Broker Up",
        "type": "stat",
        "gridPos": {"x": 0, "y": 0, "w": 6, "h": 4},
        "targets": [{"expr": "up{job=\"kafka\"}", "legendFormat": "{{instance}}"}],
        "fieldConfig": {
          "defaults": {"mappings": [{"type": "value", "options": {"0": {"color": "red", "text": "DOWN"}, "1": {"color": "green", "text": "UP"}}}], "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}}
        }
      },
      {
        "id": 2,
        "title": "Messages In/sec (per topic)",
        "type": "timeseries",
        "gridPos": {"x": 6, "y": 0, "w": 18, "h": 8},
        "targets": [{"expr": "rate(kafka_server_brokertopicmetrics_messagesin_total[1m])", "legendFormat": "{{topic}}"}],
        "fieldConfig": {"defaults": {"unit": "ops"}}
      },
      {
        "id": 3,
        "title": "Bytes In/sec (per topic)",
        "type": "timeseries",
        "gridPos": {"x": 6, "y": 8, "w": 18, "h": 8},
        "targets": [{"expr": "rate(kafka_server_brokertopicmetrics_bytesin_total[1m])", "legendFormat": "{{topic}}"}],
        "fieldConfig": {"defaults": {"unit": "Bps"}}
      },
      {
        "id": 4,
        "title": "Consumer Group Lag",
        "type": "timeseries",
        "gridPos": {"x": 0, "y": 16, "w": 12, "h": 8},
        "targets": [{"expr": "kafka_consumergroup_lag", "legendFormat": "{{consumergroup}} - {{topic}} - partition {{partition}}"}],
        "fieldConfig": {"defaults": {"unit": "short", "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 1000}, {"color": "red", "value": 10000}]}}}
      },
      {
        "id": 5,
        "title": "Under Replicated Partitions",
        "type": "stat",
        "gridPos": {"x": 12, "y": 16, "w": 6, "h": 4},
        "targets": [{"expr": "kafka_server_replicamanager_underreplicatedpartitions", "legendFormat": "Under-replicated"}],
        "fieldConfig": {"defaults": {"thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]}}}
      },
      {
        "id": 6,
        "title": "Offline Partitions",
        "type": "stat",
        "gridPos": {"x": 18, "y": 16, "w": 6, "h": 4},
        "targets": [{"expr": "kafka_controller_kafkacontroller_offlinepartitionscount", "legendFormat": "Offline"}],
        "fieldConfig": {"defaults": {"thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]}}}
      },
      {
        "id": 7,
        "title": "Request Latency (p50, p95, p99)",
        "type": "timeseries",
        "gridPos": {"x": 0, "y": 20, "w": 12, "h": 8},
        "targets": [
          {"expr": "kafka_network_requestmetrics_requestlatency_p50", "legendFormat": "p50"},
          {"expr": "kafka_network_requestmetrics_requestlatency_p95", "legendFormat": "p95"},
          {"expr": "kafka_network_requestmetrics_requestlatency_p99", "legendFormat": "p99"}
        ],
        "fieldConfig": {"defaults": {"unit": "ms"}}
      },
      {
        "id": 8,
        "title": "Controller Active",
        "type": "stat",
        "gridPos": {"x": 12, "y": 20, "w": 6, "h": 4},
        "targets": [{"expr": "kafka_controller_kafkacontroller_activecontrollercount", "legendFormat": "Active"}],
        "fieldConfig": {"defaults": {"thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}}}
      },
      {
        "id": 9,
        "title": "Log Flush Latency (p99)",
        "type": "timeseries",
        "gridPos": {"x": 18, "y": 20, "w": 12, "h": 8},
        "targets": [{"expr": "kafka_server_replicamanager_logflushtime_p99", "legendFormat": "Log Flush"}],
        "fieldConfig": {"defaults": {"unit": "ms"}}
      },
      {
        "id": 10,
        "title": "Disk Usage",
        "type": "timeseries",
        "gridPos": {"x": 0, "y": 28, "w": 12, "h": 8},
        "targets": [{"expr": "kafka_log_logsize / 1024 / 1024 / 1024", "legendFormat": "{{topic}} - {{partition}}"}],
        "fieldConfig": {"defaults": {"unit": "GB"}}
      },
      {
        "id": 11,
        "title": "Network I/O",
        "type": "timeseries",
        "gridPos": {"x": 12, "y": 28, "w": 12, "h": 8},
        "targets": [
          {"expr": "rate(kafka_server_brokertopicmetrics_bytesin_total[1m])", "legendFormat": "In"},
          {"expr": "rate(kafka_server_brokertopicmetrics_bytesout_total[1m])", "legendFormat": "Out"}
        ],
        "fieldConfig": {"defaults": {"unit": "Bps"}}
      }
    ]
  }
}