{
  "dashboard": {
    "title": "AEGIS Trino Monitoring",
    "uid": "aegis-trino",
    "tags": ["aegis", "trino", "sql", "iceberg"],
    "timezone": "utc",
    "refresh": "10s",
    "time": {"from": "now-1h", "to": "now"},
    "panels": [
      {
        "id": 1,
        "title": "Coordinator Up",
        "type": "stat",
        "gridPos": {"x": 0, "y": 0, "w": 6, "h": 4},
        "targets": [{"expr": "up{job=\"trino\"}", "legendFormat": "Coordinator"}],
        "fieldConfig": {"defaults": {"thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}}}
      },
      {
        "id": 2,
        "title": "Active Workers",
        "type": "stat",
        "gridPos": {"x": 6, "y": 0, "w": 6, "h": 4},
        "targets": [{"expr": "trino_cluster_running_queries", "legendFormat": "Running"}],
        "fieldConfig": {"defaults": {"thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]}}}
      },
      {
        "id": 3,
        "title": "Queued Queries",
        "type": "stat",
        "gridPos": {"x": 12, "y": 0, "w": 6, "h": 4},
        "targets": [{"expr": "trino_query_manager_queued_queries", "legendFormat": "Queued"}],
        "fieldConfig": {"defaults": {"thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 10}, {"color": "red", "value": 50}]}}}
      },
      {
        "id": 4,
        "title": "Running Queries",
        "type": "stat",
        "gridPos": {"x": 18, "y": 0, "w": 6, "h": 4},
        "targets": [{"expr": "trino_query_manager_running_queries", "legendFormat": "Running"}],
        "fieldConfig": {"defaults": {"thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]}}}
      },
      {
        "id": 5,
        "title": "Query Duration (p50, p95, p99)",
        "type": "timeseries",
        "gridPos": {"x": 0, "y": 4, "w": 12, "h": 8},
        "targets": [
          {"expr": "histogram_quantile(0.50, sum(rate(trino_query_duration_seconds_bucket[5m])) by (le))", "legendFormat": "p50"},
          {"expr": "histogram_quantile(0.95, sum(rate(trino_query_duration_seconds_bucket[5m])) by (le))", "legendFormat": "p95"},
          {"expr": "histogram_quantile(0.99, sum(rate(trino_query_duration_seconds_bucket[5m])) by (le))", "legendFormat": "p99"}
        ],
        "fieldConfig": {"defaults": {"unit": "s"}}
      },
      {
        "id": 6,
        "title": "Query Throughput",
        "type": "timeseries",
        "gridPos": {"x": 12, "y": 4, "w": 12, "h": 8},
        "targets": [
          {"expr": "rate(trino_query_manager_started_queries_total[1m])", "legendFormat": "Started"},
          {"expr": "rate(trino_query_manager_completed_queries_total[1m])", "legendFormat": "Completed"},
          {"expr": "rate(trino_query_manager_failed_queries_total[1m])", "legendFormat": "Failed"}
        ],
        "fieldConfig": {"defaults": {"unit": "ops"}}
      },
      {
        "id": 7,
        "title": "Memory Usage by Pool",
        "type": "timeseries",
        "gridPos": {"x": 0, "y": 12, "w": 12, "h": 8},
        "targets": [{"expr": "trino_memory_pool_usage / trino_memory_pool_max", "legendFormat": "{{pool}}"}],
        "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 0.7}, {"color": "red", "value": 0.9}]}}}
      },
      {
        "id": 8,
        "title": "Memory Pool Details",
        "type": "timeseries",
        "gridPos": {"x": 12, "y": 12, "w": 12, "h": 8},
        "targets": [
          {"expr": "trino_memory_pool_usage / 1024 / 1024 / 1024", "legendFormat": "{{pool}} Used (GB)"},
          {"expr": "trino_memory_pool_max / 1024 / 1024 / 1024", "legendFormat": "{{pool}} Max (GB)"}
        ],
        "fieldConfig": {"defaults": {"unit": "GB"}}
      },
      {
        "id": 9,
        "title": "Failed Queries Rate",
        "type": "timeseries",
        "gridPos": {"x": 0, "y": 20, "w": 12, "h": 8},
        "targets": [{"expr": "rate(trino_query_manager_failed_queries_total[5m])", "legendFormat": "Failed/sec"}],
        "fieldConfig": {"defaults": {"unit": "ops", "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 0.1}]}}}
      },
      {
        "id": 10,
        "title": "CPU Usage",
        "type": "timeseries",
        "gridPos": {"x": 12, "y": 20, "w": 12, "h": 8},
        "targets": [{"expr": "rate(process_cpu_seconds_total[1m])", "legendFormat": "CPU"}],
        "fieldConfig": {"defaults": {"unit": "percentunit"}}
      },
      {
        "id": 11,
        "title": "GC Time",
        "type": "timeseries",
        "gridPos": {"x": 0, "y": 28, "w": 12, "h": 8},
        "targets": [{"expr": "rate(jvm_gc_collection_seconds_sum[5m])", "legendFormat": "{{collector}}"}],
        "fieldConfig": {"defaults": {"unit": "s"}}
      },
      {
        "id": 12,
        "title": "Heap Usage",
        "type": "timeseries",
        "gridPos": {"x": 12, "y": 28, "w": 12, "h": 8},
        "targets": [
          {"expr": "jvm_memory_bytes_used{area=\"heap\"} / 1024 / 1024 / 1024", "legendFormat": "Heap Used (GB)"},
          {"expr": "jvm_memory_bytes_max{area=\"heap\"} / 1024 / 1024 / 1024", "legendFormat": "Heap Max (GB)"}
        ],
        "fieldConfig": {"defaults": {"unit": "GB"}}
      },
      {
        "id": 13,
        "title": "Iceberg Table Scan Rows",
        "type": "timeseries",
        "gridPos": {"x": 0, "y": 36, "w": 12, "h": 8},
        "targets": [{"expr": "rate(trino_iceberg_scan_rows_read_total[1m])", "legendFormat": "{{table}}"}],
        "fieldConfig": {"defaults": {"unit": "ops"}}
      },
      {
        "id": 14,
        "title": "Iceberg Scan Bytes",
        "type": "timeseries",
        "gridPos": {"x": 12, "y": 36, "w": 12, "h": 8},
        "targets": [{"expr": "rate(trino_iceberg_scan_bytes_read_total[1m]) / 1024 / 1024", "legendFormat": "{{table}}"}],
        "fieldConfig": {"defaults": {"unit": "MBps"}}
      },
      {
        "id": 15,
        "title": "Split Generation Time",
        "type": "timeseries",
        "gridPos": {"x": 0, "y": 44, "w": 12, "h": 8},
        "targets": [{"expr": "rate(trino_split_generation_time_seconds_sum[5m])", "legendFormat": "{{connector}}"}],
        "fieldConfig": {"defaults": {"unit": "s"}}
      },
      {
        "id": 16,
        "title": "Active Threads",
        "type": "timeseries",
        "gridPos": {"x": 12, "y": 44, "w": 12, "h": 8},
        "targets": [{"expr": "jvm_threads_current", "legendFormat": "Threads"}],
        "fieldConfig": {"defaults": {"unit": "short"}}
      }
    ]
  }
}