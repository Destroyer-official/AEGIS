# ==============================================================================
# AEGIS Platform — Production Environment Configuration Template
# ==============================================================================
# In production, AEGIS strictly fails closed if JWT_SECRET is unset or < 32 characters.
# Generate a cryptographically strong secret: openssl rand -base64 48
# ==============================================================================

# Deployment Environment ('production' | 'staging' | 'development')
AEGIS_ENV=production

# Gateway HTTP & gRPC Service Binding
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=3000
GRPC_PORT=50051

# JWT Zero-Trust Authentication (Mandatory: minimum 32 characters)
JWT_SECRET=change-me-to-a-cryptographically-secure-random-key-at-least-32-chars-long!
JWT_EXPIRATION_SECS=3600

# Initial Root Administrative Credentials (Hashed via Argon2id at startup)
INITIAL_ADMIN_PASSWORD=change-me-to-a-secure-admin-password-2026!
INITIAL_ANALYST_PASSWORD=change-me-to-a-secure-analyst-password-2026!
INITIAL_VIEWER_PASSWORD=change-me-to-a-secure-viewer-password-2026!

# Proxy & Network Security
# Only set TRUST_PROXY=true if deployed behind a verified reverse proxy (e.g. Cloudflare, AWS ALB)
TRUST_PROXY=false

# Token-Bucket Rate Limiting (Per-client / tenant)
RATE_LIMIT_RPS=100
RATE_LIMIT_BURST=200

# Trino Coordinator & Distributed Iceberg Storage
TRINO_COORDINATOR_URL=http://trino:8080
TRINO_CATALOG=iceberg
TRINO_SCHEMA=aegis

# Event Bus & Streaming Infrastructure
KAFKA_BROKERS=kafka:9092
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
NESSIE_URI=http://nessie:19120/api/v1

# Logging & Telemetry
RUST_LOG=info
OTEL_SDK_DISABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4317
